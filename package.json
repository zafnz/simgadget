{
  "name": "simgadget-workspace",
  "private": true,
  "description": "Workspace root for the simgadget library and the simgadget-mcp server. Publishes nothing; see packages/.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zafnz/ios-multi-simulator-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=simgadget",
    "smoke": "bash scripts/smoke-packed.sh",
    "gen:proto": "mkdir -p packages/simgadget/src/idb/generated && protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=packages/simgadget/src/idb/generated --ts_proto_opt=outputServices=grpc-js,env=node,esModuleInterop=true,useOptionals=messages,outputJsonMethods=false --proto_path=vendor/idb/proto vendor/idb/proto/idb.proto",
    "gen:keymap": "node scripts/gen-keymap.mjs",
    "gen": "npm run gen:proto && npm run gen:keymap",
    "build:companion": "cd vendor/idb && XCODEGEN_STRIP_XATTRS=false ./build.sh build",
    "verify:download": "node scripts/verify-companion-download.mjs",
    "check:companion": "node scripts/check-companion-contract.mjs",
    "predev": "npm run build --workspaces",
    "dev": "npx @modelcontextprotocol/inspector node packages/simgadget-mcp/build/index.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "0.16.8",
    "@types/node": "^22.0.2",
    "ts-proto": "^2.12.0",
    "typescript": "^5.5.4"
  }
}
